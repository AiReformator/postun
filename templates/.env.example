# Postun Beta - local template only. Never enter production secrets here.
# Empty values must fail closed. Provision real secrets through an approved channel.
APP_ENV=development
PUBLIC_SITE_URL=https://postun.org
APP_ORIGIN=https://app.postun.org
AUTH_ISSUER=https://auth.postun.org
MCP_RESOURCE=https://mcp.postun.org/mcp
ADMIN_ORIGIN=https://admin.postun.org
# Runtime bindings D1/DO/KV are configured separately, not as credentials below.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
SESSION_KEK=
SESSION_KEK_VERSION=
IDENTITY_INDEX_HMAC_KEY=
IDENTITY_ENCRYPTION_KEY=
WEB_SESSION_KEY=
# Set only in the Admin Worker; never in Pages or the MCP vault.
IDP_ISSUER=
IDP_PROJECT_ID=
IDP_ORG_ID=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
ADMIN_SESSION_KEY=
# Product ceiling is 512000000 bytes. Enable only an actually tested size.
MAX_FILE_BYTES=
BETA_MONTHLY_SUCCESS_LIMIT=100
BETA_MONTHLY_BYTE_LIMIT=
# Never place a Cloudflare management token in application runtime.
