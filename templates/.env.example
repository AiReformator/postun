# Postun Beta - local template only. Never enter production secrets here.
# Empty values must fail closed. Set real secrets with "npx wrangler secret put NAME", never in this file.
APP_ENV=development
PUBLIC_SITE_URL=https://postun.org
APP_ORIGIN=https://app.postun.org
AUTH_ISSUER=https://auth.postun.org
MCP_RESOURCE=https://mcp.postun.org/mcp
ADMIN_ORIGIN=https://admin.postun.org
# Runtime bindings D1/DO/KV are configured separately, not as credentials below.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
SESSION_KEK=
SESSION_KEK_VERSION=
IDENTITY_INDEX_HMAC_KEY=
IDENTITY_ENCRYPTION_KEY=
WEB_SESSION_KEY=
# Administrator sign-in provider (OIDC). Set only in the Admin Worker; never in the web site or the MCP vault.
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_SCOPES=
ADMIN_OIDC_ROLES_CLAIM=
# Required: key a role's value object must contain, or the literal "none" to disable the check.
ADMIN_OIDC_ROLES_TENANT=
# Required: value id_token aud must include, or the literal "none" to disable the check.
ADMIN_OIDC_EXTRA_AUDIENCE=
ADMIN_SESSION_KEY=
# Product ceiling is 512000000 bytes. Enable only an actually tested size.
MAX_FILE_BYTES=
BETA_DAILY_SUCCESS_LIMIT=10000
BETA_MONTHLY_SUCCESS_LIMIT=310000
BETA_MONTHLY_BYTE_LIMIT=
# Never place a Cloudflare management token in application runtime.
