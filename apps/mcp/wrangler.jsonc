{
  "name": "postun-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  // Template only; the operator fills in the real zone. No account/zone IDs live in the repository.
  // "routes": [{ "pattern": "mcp.postun.org", "custom_domain": true }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionAndQuotaDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionAndQuotaDO"] }],
  "services": [
    { "binding": "AUTH", "service": "postun-auth" },
    { "binding": "ADMIN_SINK", "service": "postun-admin", "entrypoint": "ProjectionSink" }
  ],
  // Aggregate service metrics, no identifiers (docs/03 "Service metrics"). No resource ID: the dataset is created on first write.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "postun_metrics" }],
  "vars": {
    "APP_ENV": "production",
    "MCP_RESOURCE": "https://mcp.postun.org/mcp",
    "AUTH_ISSUER": "https://auth.postun.org",
    "BETA_MONTHLY_SUCCESS_LIMIT": "310000",
    "BETA_DAILY_SUCCESS_LIMIT": "10000",
    "MAX_FILE_BYTES": "512000000",
    "FEATURE_CHANNELS": "on",
    "TELEGRAM_ADAPTER": "mtcute"
  },
  "env": {
    "staging": {
      "name": "postun-mcp-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
      // "routes": [{ "pattern": "mcp.staging.postun.org", "custom_domain": true }],
      "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
      "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionAndQuotaDO" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionAndQuotaDO"] }],
      "services": [
        { "binding": "AUTH", "service": "postun-auth-staging" },
        { "binding": "ADMIN_SINK", "service": "postun-admin-staging", "entrypoint": "ProjectionSink" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "postun_metrics_staging" }],
      "vars": {
        "APP_ENV": "staging",
        "MCP_RESOURCE": "https://mcp.staging.postun.org/mcp",
        "AUTH_ISSUER": "https://auth.staging.postun.org",
        "BETA_MONTHLY_SUCCESS_LIMIT": "100",
        "MAX_FILE_BYTES": "0",
        "FEATURE_CHANNELS": "off",
        "TELEGRAM_ADAPTER": "mtcute"
      }
    }
  }
}
