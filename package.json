{
  "name": "postun",
  "private": true,
  "description": "Postun Beta \u2014 experimental open MCP connector for your own Telegram account",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit:docs": "python3 -I scripts/audit_docs.py .",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:secrets"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@types/node": "22.20.5"
  }
}