{
  "name": "postun",
  "private": true,
  "description": "Postun Beta \u2014 experimental open MCP connector for your own Telegram account",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:logging": "node scripts/check-no-logging.mjs",
    "test:scripts": "node --test scripts/",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:scripts && npm run build && npm run check:secrets && npm run check:logging && npm run check:docs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.1",
    "wrangler": "4.162.0",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@types/node": "26.6.6"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
